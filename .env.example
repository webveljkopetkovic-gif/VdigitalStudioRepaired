# Contact form (/api/contact) sends email through Spacemail SMTP.
# Add these in Vercel Project Settings -> Environment Variables.
SMTP_USER="hello@vdigital.dev"
SMTP_PASS="YOUR_SPACEMAIL_PASSWORD"
# Optional (defaults shown):
# SMTP_HOST="mail.spacemail.com"
# SMTP_PORT="465"
# CONTACT_TO="hello@vdigital.dev"

# Cloudflare Turnstile (anti-spam). Site key is public, secret stays on the server.
VITE_TURNSTILE_SITE_KEY="YOUR_TURNSTILE_SITE_KEY"
TURNSTILE_SECRET_KEY="YOUR_TURNSTILE_SECRET_KEY"
